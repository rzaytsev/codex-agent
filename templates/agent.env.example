AGENT_NAME=NAME
# Required: bot token and comma-separated NUMERIC Telegram user IDs. Empty = deny all.
TELEGRAM_BOT_TOKEN=
# Exactly one numeric Telegram owner ID. Empty starts in setup mode.
TELEGRAM_ALLOWED_USER_IDS=
# Host paths outside the continuously synced source tree.
WORKSPACE_HOST_PATH=/srv/agent-data/NAME/workspace
CODEX_HOST_PATH=/srv/agent-data/NAME/codex
# Optional override; default is /run/agent-seed/plugins.json inside the container.
PLUGINS_FILE=
TIMEZONE=UTC
# Empty model names use the authenticated Codex runtime default.
MAIN_MODEL=
MAIN_REASONING=low
WORKER_MODEL=
WORKER_REASONING=high
RESEARCH_MODEL=
RESEARCH_REASONING=medium
DEEP_RESEARCH_MODEL=
DEEP_RESEARCH_REASONING=high
RESEARCH_MAX_SOURCES=40
REVIEW_MODEL=
REVIEW_REASONING=high
MAX_WORKERS=2
MAX_MAIN_TURNS=2
MAX_EXECUTIONS=4
MAIN_TIMEOUT_SECONDS=180
WORKER_TIMEOUT_SECONDS=1800
# Optional cumulative logical-run budgets; zero disables each control.
RUN_MAX_WALL_SECONDS=0
RUN_MAX_SERVICE_TOOLS=0
RUN_MAX_ARTIFACT_BYTES=0
# Observed attributable tokens gate only the next attempt, never in-flight spend.
RUN_OBSERVED_TOKEN_ADMISSION=0
PROACTIVE_ENABLED=true
DAILY_REVIEW_CRON=0 19 * * *
WEEKLY_REVIEW_CRON=0 18 * * 0
MONTHLY_REVIEW_CRON=0 18 1 * *
# One workspace cleanup agent job daily, in TIMEZONE; separate from reflections.
CLEANUP_ENABLED=true
CLEANUP_CRON=0 3 * * *
# Quiet, idle-only consolidation of collected memory; independent of reflections.
MEMORY_ENABLED=true
MEMORY_DAILY_CRON=15 3 * * *
MEMORY_WEEKLY_CRON=45 3 * * 0
MEMORY_MAX_BATCHES=4
# Quiet learning from collected sessions/outcomes, independently of notifications.
LEARNING_ENABLED=true
LEARNING_CRON=30 3 * * *
LEARNING_MAX_BATCHES=2
QUIET_START_HOUR=22
QUIET_END_HOUR=8
WHISPER_MODEL=base
WHISPER_LANGUAGE=
TTS_VOICE=en
MAX_ATTACHMENT_MB=20

# Optional Google Places and Routes access for the shared Maps skill
GOOGLE_MAPS_API_KEY=

# Browser tools use isolated headless Chromium sessions
BROWSER_ENABLED=true
BROWSER_EXECUTABLE=/usr/bin/chromium

# Optional private agent mailbox; configure all three together. See docs/agent-messaging.md.
MAILBOX_ID=
MAILBOX_URL=
MAILBOX_TOKEN=

# Brokered action policy; only narrowing overrides are allowed.
# ACTION_POLICY={"external_send":"deny"}
ACTION_APPROVAL_TTL_SECONDS=600
# Prototype task cwd only; not credential isolation. Live-auth acceptance required.
READ_ONLY_WORKSPACE_PROTOTYPE=false
# Research/read/internal-review only; full isolation INCOMPLETE AND BLOCKING.
# Fresh empty cwd/thread, no application file grant or fallback; requires opt-in validation.
RESTRICTED_READ_PROFILE_PROTOTYPE=false
