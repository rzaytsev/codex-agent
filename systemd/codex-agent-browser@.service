[Unit]
Description=Disposable networkless browser render
CollectMode=inactive-or-failed

[Service]
EnvironmentFile=/etc/codex-agent-browser.env
ExecStart=/usr/local/libexec/codex-agent-browser ${CODEX_AGENT_BROWSER_IMAGE}
ExecStopPost=/usr/local/libexec/codex-agent-browser --cleanup ${INVOCATION_ID}
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeMaxSec=35s
TimeoutStopSec=12s
