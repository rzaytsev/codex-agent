[Unit]
Description=Restricted Telegram group execution broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/codex-agent/scripts/group-executor-broker.py --config /etc/codex-agent-group-executors.json
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
