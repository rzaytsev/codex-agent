[
  {
    "id": "restart-correction-cas",
    "steps": [
      {
        "op": "history",
        "id": "original",
        "text": "В рассылке Лиственница должно быть семь заметок.",
        "origin": "direct_owner"
      },
      {
        "op": "tool",
        "id": "save",
        "tool": "memory_save",
        "args": {
          "key": "larch",
          "category": "facts",
          "title": "larch",
          "content": "Семь заметок в рассылке Лиственница.",
          "certainty": "confirmed",
          "sources": [
            "$source:original"
          ],
          "expected_revision": 0,
          "status": "active",
          "entity": "newsletter-larch",
          "project": "Лиственница"
        }
      },
      {
        "op": "reopen",
        "id": "restart"
      },
      {
        "op": "tool",
        "id": "persisted",
        "tool": "memory_read",
        "args": {
          "key": "larch"
        }
      },
      {
        "op": "history",
        "id": "correction",
        "text": "Исправление: для рассылки Лиственница теперь четыре записи.",
        "origin": "direct_owner"
      },
      {
        "op": "tool",
        "id": "correct",
        "tool": "memory_save",
        "args": {
          "key": "larch",
          "category": "facts",
          "title": "larch",
          "content": "Четыре записи в рассылке Лиственница.",
          "certainty": "confirmed",
          "sources": [
            "$source:correction"
          ],
          "expected_revision": 1,
          "status": "active"
        }
      },
      {
        "op": "tool",
        "id": "stale",
        "tool": "memory_save",
        "args": {
          "key": "larch",
          "category": "facts",
          "title": "larch",
          "content": "Восемь записей.",
          "certainty": "confirmed",
          "sources": [
            "$source:correction"
          ],
          "expected_revision": 1,
          "status": "active"
        }
      },
      {
        "op": "tool",
        "id": "recall",
        "tool": "memory_search",
        "args": {
          "query": "Лиственница",
          "entity": "newsletter-larch"
        }
      },
      {
        "op": "tool",
        "id": "paraphrase",
        "tool": "memory_search",
        "args": {
          "query": "заметки"
        }
      }
    ]
  },
  {
